# Usage: vmdm [STRUCT] [TRAJ ...] [key=value ...]     e.g.  vmdm system.pdb traj{1..5}.xtc stride=10 box=1
#
# Settings for vmdm, read from ./vmd.config in the directory you run it from.
# One 'key = value' per line; '#' starts a comment. Every key below can be overridden
# for one run as key=value on the command line. An empty value means "automatic".
# Wrap a value in quotes if it must contain a '#'. Keys left out use built-in defaults.
# The 'reps' block at the end holds VMD Tcl commands (from 'reps = <<END' to 'END').

# --- Trajectory files ----------------------------------------------------------------
traj_type	=			# dcd|xtc|trr for all files; empty = from each file's extension
sort		= 1			# 1 = natural order (traj2 before traj10), 0 = order as given

# --- Frames to use ---------------------------------------------------------------------
step		= 1			# use every step-th trajectory frame ...
stride		= 1			# ... times stride: only every (step x stride)-th frame is loaded and rendered

# --- Simulation timing (for the time stamp) --------------------------------------------
md_ts_fs	= 10			# MD integration time step, fs
md_nsave	= 1000			# MD steps between saved frames (nstxout-compressed / dcdfreq)

# --- PBC and alignment -----------------------------------------------------------------
pbc_sel		= not water		# atoms made whole/unwrapped (keep solvent out: it is slow); empty = no PBC processing
align_sel	= chain A and resid 210 to 220 and name CA	# VMD selection fitted to frame 0; empty = centre on COM only

# --- Rendering -------------------------------------------------------------------------
vmd		= vmd			# VMD executable (name on PATH or full path)
frames_dir	= frames		# directory for the PNG frames (cleared of old frames each run)
imgsize		= 1000x1000		# image size, WxH or a single number for square
zoom		= 1.5			# zoom after resetting the view (<1 zooms out)
box		= 0			# 1 = draw the periodic box, 0 = no box

# --- Movie -----------------------------------------------------------------------------
fps		= 8			# movie frames per second
mp4		=			# output movie; empty = traj.mp4, or traj1-traj5.mp4 for several files

# --- Time stamp ------------------------------------------------------------------------
stamp		= 1			# 1 = print 't = ... ns' on the movie, 0 = off
t0		=			# time of first trajectory frame, ns; empty = 0 (xtc/trr) or one save interval (dcd)
tdec		=			# decimals 0-6; empty = just enough to change every frame
tsize		= 40			# font size, px
tx		= 0.03			# left edge of the stamp, fraction of frame width (0 = left, ~0.75 = right side)
ty		= 0.03			# top edge of the stamp, fraction of frame height (0 = top, ~0.95 = bottom)
tcolor		= black			# font colour (ffmpeg colour name or 0xRRGGBB)
tfont		= Sans			# font name, or path to a .ttf/.otf file

# --- Representations and display style -----------------------------------------------
# VMD Tcl commands run after the trajectory is loaded, kept verbatim up to the 'END' line.
# Rep 0 exists from loading (change it with 'mol mod...  0 0'); each 'mol addrep 0' adds
# the next one (1, 2, ...), using the 'mol color/representation/selection/material' set
# before it. Without this block, vmdm shows a plain cartoon coloured by chain.
reps = <<END
axes location Off
display projection Orthographic
color Display Background white
display backgroundgradient off
mol modstyle 0 0 Tube 1.500000 12.000000
mol modcolor 0 0 Chain
mol modselect 0 0 chain A B and resid 36 to 311
mol material Opaque
mol color Chain
mol representation VDW 1.500000 12.000000
mol selection resname SEP TPO
mol material Opaque
mol addrep 0
mol color Chain
mol representation Tube 1.500000 12.000000
mol selection chain A B and resid 867 to 927
mol material Opaque
mol addrep 0
mol color Chain
mol representation Tube 1.500000 12.000000
mol selection chain A B and not resid 36 to 311 867 to 927
mol material Opaque
mol addrep 0
mol modmaterial 3 0 BlownGlass
mol color Chain
mol representation Tube 1.500000 12.000000
mol selection chain C D
mol material Opaque
mol addrep 0
mol modcolor 4 0 ColorID 19
mol representation Tube 1.500000 12.000000
mol selection chain E F
mol material Opaque
mol addrep 0
mol modcolor 5 0 ColorID 17
END